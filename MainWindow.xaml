<Window x:Class="GitPuller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Git Puller" Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">

	<Window.Resources>
		<Style TargetType="Button">
			<Setter Property="Padding" Value="10,5"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Background" Value="#FF007ACC"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
							<ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter Property="Background" Value="#FF005A9B"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter Property="Background" Value="#FF004578"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style TargetType="TextBox">
			<Setter Property="Padding" Value="8,4"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="BorderBrush" Value="#FFCCCCCC"/>
		</Style>

		<Style TargetType="Label">
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Margin" Value="5,5,5,0"/>
		</Style>

		<Style TargetType="ListBox">
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="BorderBrush" Value="#FFCCCCCC"/>
		</Style>

		<Style TargetType="TreeView">
			<Setter Property="FontFamily" Value="Segoe UI"/>
			<Setter Property="Margin" Value="5"/>
			<Setter Property="BorderBrush" Value="#FFCCCCCC"/>
		</Style>
	</Window.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
		</Grid.RowDefinitions>

		<!-- Start Pulling Button -->
		<Button Name="StartPullingButton"
                Grid.Row="0"
                Content="Start Pulling"
                Height="50"
                FontSize="14"
                Click="StartPullingButton_Click"
                Visibility="{Binding StartPullingVisibility}"/>

		<!-- Access Token Section -->
		<StackPanel Grid.Row="1"
                    Visibility="{Binding AccessTokenVisibility}">
			<Label Content="Access Token:"/>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBox Name="AccessTokenTextBox"
                         Grid.Column="0"
                         Text="{Binding AccessToken, UpdateSourceTrigger=PropertyChanged}"/>
				<Button Name="EnterTokenButton"
                        Grid.Column="1"
                        Content="Enter"
                        Click="EnterTokenButton_Click"/>
			</Grid>
		</StackPanel>

		<!-- Remove Token Button -->
		<Button Name="RemoveTokenButton"
                Grid.Row="1"
                Content="Remove Token"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="5,35,5,5"
                Background="#FFDC3545"
                Click="RemoveTokenButton_Click"
                Visibility="{Binding RemoveTokenVisibility}"/>

		<!-- Repository Path Section -->
		<StackPanel Grid.Row="2">
			<Label Content="Local Files Path:"/>
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="*"/>
					<ColumnDefinition Width="Auto"/>
				</Grid.ColumnDefinitions>
				<TextBox Name="PathTextBox"
                         Grid.Column="0"
                         Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}"/>
				<Button Name="AddPathButton"
                        Grid.Column="1"
                        Content="Add"
                        Click="AddPathButton_Click"/>
			</Grid>
		</StackPanel>

		<!-- Paths Management Section -->
		<Grid Grid.Row="3" Height="120">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<ListBox Name="PathsListBox"
                     Grid.Column="0"
                     ItemsSource="{Binding RepositoryPaths}"
                     SelectedItem="{Binding SelectedPath}"/>

			<StackPanel Grid.Column="1" VerticalAlignment="Top">
				<Button Name="RemoveSelectedPathButton"
                        Content="Remove Selected"
                        Width="120"
                        Background="#FFDC3545"
                        Click="RemoveSelectedPathButton_Click"
                        IsEnabled="{Binding HasSelectedPath}"/>
				<Button Name="ClearAllPathsButton"
                        Content="Clear All"
                        Width="120"
                        Background="#FFDC3545"
                        Click="ClearAllPathsButton_Click"
                        IsEnabled="{Binding HasPaths}"/>
			</StackPanel>
		</Grid>

		<!-- TreeView for Repositories and Branches -->
		<TreeView Name="RepositoryTreeView"
                  Grid.Row="5"
                  ItemsSource="{Binding RepositoryNodes}">
			<TreeView.ItemTemplate>
				<HierarchicalDataTemplate ItemsSource="{Binding Children}">
					<TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
					<HierarchicalDataTemplate.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding DisplayName}"
                                       Foreground="#FF666666"
                                       Margin="5,0,0,0"/>
						</DataTemplate>
					</HierarchicalDataTemplate.ItemTemplate>
				</HierarchicalDataTemplate>
			</TreeView.ItemTemplate>
		</TreeView>
	</Grid>
</Window>